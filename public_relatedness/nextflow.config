// Use -C with this file to exclude the historical root configuration.
manifest {
    name = 'public-shallow-wgs-relatedness-development'
    version = '0.1.0-dev'
    nextflowVersion = '>=24.10.3'
}
params {
    samples = null
    pairs = null
    reference = null
    pe150_bins = null
    pe150_bins_sha256 = '1d62a94b9a88845978c7bf709d00b35b0f3b1243ef894b442c3ac2861a23337c'
    outdir = 'public_relatedness_results'
    paired_end = true
    crop_50 = false
    reference_genome_path = null
    output_directory = null
    pcc_llr_runner = null
    pfreq = null
    llr_helper = null
    breakpoint_preprocessing = null
    breakpoint_matching = null
    fraction_implementation = null
    metrics_rscript = 'Rscript'
    breakpoint_rscript = 'Rscript'
    metrics_container = null
    called_rds = null
    validated_samples = null
    validated_pairs = null
    image_directory = null
    temp_directory = null
}
// Keep the same absolute path inside containers and on the execution host.
def tempBind = params.temp_directory ? "'" + (params.temp_directory.toString() + ':' +
    params.temp_directory.toString() + ':rw').replace("'", "'\"'\"'") + "'" : null
env.TMPDIR = params.temp_directory ?: '/tmp'
process {
    executor = 'local'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    maxForks = 1
    withName: 'TRIMMOMATIC|ALIGNMENT|MARK_DUPLICATES' {
        scratch = params.temp_directory ?: '/tmp'
    }
    withName: PREPARE_MANIFEST {
        executor = 'local'
        container = null
        cpus = 1
        memory = '1 GB'
    }
}
profiles {
    local { process.executor = 'local' }
    docker {
        docker.enabled = true
        docker.runOptions = tempBind ? "--volume ${tempBind}" : ''
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = tempBind ? "--bind ${tempBind}" : ''
    }
    slurm { process.executor = 'slurm' }
}
cleanup = false
