// Use -C with this file to exclude the historical root configuration.
manifest {
    name = 'public-shallow-wgs-relatedness-development'
    version = '0.1.1-dev'
    nextflowVersion = '>=24.10.3'
}
params {
    resource_directory = null
    samples = null
    pairs = null
    reference = null
    pe150_bins = null
    pe150_bins_sha256 = '1d62a94b9a88845978c7bf709d00b35b0f3b1243ef894b442c3ac2861a23337c'
    outdir = 'public_relatedness_results'
    paired_end = true
    crop_50 = false
    reference_genome_path = null
    output_directory = null
    pcc_llr_runner = null
    pfreq = null
    llr_helper = null
    breakpoint_preprocessing = null
    breakpoint_matching = null
    fraction_implementation = null
    metrics_rscript = null
    breakpoint_rscript = null
    metrics_container = null
    called_rds = null
    validated_samples = null
    validated_pairs = null
    image_directory = null
    temp_directory = null
}
// Lazy interpolation observes later runtime.config / JSON values after config merging.
env.TMPDIR = "${-> params.temp_directory ?: '/tmp'}"
process {
    executor = 'local'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    maxForks = 1
    withName: 'TRIMMOMATIC|ALIGNMENT|MARK_DUPLICATES' {
        scratch = { params.temp_directory ?: '/tmp' }
    }
    withName: 'TRIMMOMATIC' {
        container = {
            def local = params.image_directory ? new File(params.image_directory.toString(), 'staphb-trimmomatic-latest.img') : null
            local?.isFile() ? local.absolutePath : 'docker://staphb/trimmomatic@sha256:97a09b4b6e3af6c372629ea79322237e031e9e0d19e9891b48b5423c096c6157'
        }
    }
    withName: 'ALIGNMENT' {
        container = {
            def local = params.image_directory ? new File(params.image_directory.toString(), 'blcdsdockerregistry-bwa-mem2_samtools-1.12-2.2.1.img') : null
            local?.isFile() ? local.absolutePath : 'docker://blcdsdockerregistry/bwa-mem2_samtools-1.12@sha256:d22cc3f091e2064ae501d4958a2466a2cb60a0e5fe5d340fe38335cdf71b1ad9'
        }
    }
    withName: 'MARK_DUPLICATES' {
        container = {
            def local = params.image_directory ? new File(params.image_directory.toString(), 'broadinstitute-picard-latest.img') : null
            local?.isFile() ? local.absolutePath : 'docker://broadinstitute/picard@sha256:de4d1f713e6b42ac3cb7b74a68174f00f7fdba8366eedcd13a30b242625a10c5'
        }
    }
    withName: 'QDNASEQ_COHORT|CGHCALL_COHORT' {
        container = {
            def local = params.image_directory ? new File(params.image_directory.toString(), 'huntsmanlab-qdnaseq-latest.img') : null
            local?.isFile() ? local.absolutePath : 'docker://huntsmanlab/qdnaseq@sha256:d7dc98dff858d0663bc84ceccaa8e2792af18bcf54af964e20c633eb7668cbb9'
        }
    }
    // Small scoring inputs/scripts are copied to avoid mounting their source trees.
    // This reduces mounts that could hide absolute R prefixes preserved inside the SIF.
    withName: 'SCORE_AND_AGGREGATE' {
        stageInMode = 'copy'
    }
    withName: PREPARE_MANIFEST {
        executor = 'local'
        container = null
        cpus = 1
        memory = '1 GB'
    }
}
profiles {
    local { process.executor = 'local' }
    docker {
        docker.enabled = true
        docker.runOptions = "${-> params.temp_directory ? '--volume ' + "'" + (params.temp_directory.toString() + ':' + params.temp_directory.toString() + ':rw').replace("'", "'\"'\"'") + "'" : ''}"
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = "${-> params.temp_directory ? '--bind ' + "'" + (params.temp_directory.toString() + ':' + params.temp_directory.toString() + ':rw').replace("'", "'\"'\"'") + "'" : ''}"
    }
    slurm { process.executor = 'slurm' }
}
cleanup = false
