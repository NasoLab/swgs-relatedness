// Supply independently obtained, permission-cleared frozen resources.
params {
    pcc_llr_runner = '/path/to/permission_cleared/run_pcc_llr.R'
    pfreq = '/path/to/pfreq_lusc_tcga_split.csv'
    llr_helper = '/path/to/clonality_analysis_PFREQ_MOD.R'
    breakpoint_preprocessing = '/path/to/test_relatedness_cohort_qc_pass.R'
    breakpoint_matching = '/path/to/breakclone_copynumber_712eb202.R'
    fraction_implementation = '/path/to/regress_fraction_shared.py'
    metrics_rscript = '/path/to/validated_llr_environment/bin/Rscript'
    breakpoint_rscript = '/path/to/validated_breakpoint_environment/bin/Rscript'
    // null runs these commands on the host. A future image must contain both
    // validated runtimes, Python >=3.9, and their dependency versions.
    metrics_container = null
}
