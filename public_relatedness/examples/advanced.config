// Optional explicit reference locations; omitted keys resolve from resource_directory.
params {
    reference = null
    pe150_bins = null
    pfreq = null
    llr_helper = null
    // Scientific source overrides must match the frozen packaging SHA256 values.
    pcc_llr_runner = null
    breakpoint_preprocessing = null
    breakpoint_matching = null
    fraction_implementation = null
    // Separate validated host executables, or canonical paths inside a metrics SIF.
    metrics_rscript = null
    breakpoint_rscript = null
    metrics_container = null
}
