// Execution environment, configured once per installation; no scientific script paths.
params {
    image_directory = null // defaults to resource_directory/containers for the metrics SIF
    // Optional cache override; exact retained local upstream archives are also supported.
    temp_directory = '/path/to/large_volume/tmp'
}
// Preserve tested optional-monitoring workaround for the frozen Picard runtime.
trace.enabled = false
report.enabled = false
timeline.enabled = false
executor.queueSize = 1
process.containerOptions = '--cleanenv --containall --no-home --no-mount hostfs,cwd'
