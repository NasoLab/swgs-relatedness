// Use with -C nextflow.config,pinned-images.config and -profile singularity.
// Verify archives with bin/validate_setup.py --check-images before execution.
process {
    withName: TRIMMOMATIC {
        container = "${params.image_directory}/staphb-trimmomatic-latest.img"
    }
    withName: ALIGNMENT {
        container = "${params.image_directory}/blcdsdockerregistry-bwa-mem2_samtools-1.12-2.2.1.img"
    }
    withName: MARK_DUPLICATES {
        container = "${params.image_directory}/broadinstitute-picard-latest.img"
    }
    withName: 'QDNASEQ_COHORT|CGHCALL_COHORT' {
        container = "${params.image_directory}/huntsmanlab-qdnaseq-latest.img"
    }
}
