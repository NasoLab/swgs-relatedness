// Use with the singularity profile. The base config supplies temp_directory's bind.
executor.queueSize = 1
process.containerOptions = '--cleanenv --containall --no-home --no-mount hostfs,cwd'
// Retained Picard uutils date is incompatible with Nextflow 24.10 resource timing.
trace.enabled = false
report.enabled = false
timeline.enabled = false
